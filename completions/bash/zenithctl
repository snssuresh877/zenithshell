# Bash completion for zenithctl & zenithshell

_zenithctl_completions() {
    local cur prev words cword
    _init_completion || return

    local commands="wallpaper wp theme brightness bri clipboard clip toggle bar launcher spotlight control-center cc notifications nc reminders active-apps keybinds network audio power stats reload help version"

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return 0
    fi

    local cmd="${words[1]}"
    case "$cmd" in
        wallpaper|wp)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "cycle next set current dir" -- "$cur"))
            elif [[ $cword -eq 3 && "${words[2]}" == "set" ]]; then
                _filedir
            elif [[ $cword -eq 3 && "${words[2]}" == "dir" ]]; then
                _filedir -d
            fi
            ;;
        theme)
            if [[ $cword -eq 2 ]]; then
                local themes=$(zenithctl __complete themes 2>/dev/null)
                COMPREPLY=($(compgen -W "set next current list $themes" -- "$cur"))
            elif [[ $cword -eq 3 && "${words[2]}" == "set" ]]; then
                local themes=$(zenithctl __complete themes 2>/dev/null)
                COMPREPLY=($(compgen -W "$themes" -- "$cur"))
            fi
            ;;
        brightness|bri)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "set up down current" -- "$cur"))
            fi
            ;;
        clipboard|clip)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "clear store" -- "$cur"))
            fi
            ;;
        toggle)
            if [[ $cword -eq 2 ]]; then
                local modules=$(zenithctl __complete modules 2>/dev/null)
                COMPREPLY=($(compgen -W "$modules" -- "$cur"))
            fi
            ;;
        stats)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=($(compgen -W "--json" -- "$cur"))
            fi
            ;;
    esac
}

complete -F _zenithctl_completions zenithctl
complete -F _zenithctl_completions zenithshell
