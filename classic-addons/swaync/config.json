{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "control-center-width": 360,
  "control-center-height": 680,
  "fit-to-clear-all": false,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "notification-visibility": {
    "whatsapp": {
      "state": "enabled",
      "urgency": "High",
      "override-timeout": 12
    },
    "wechat": {
      "state": "enabled",
      "urgency": "High",
      "override-timeout": 12
    }
  },
  "widgets": [
    "mpris",
    "buttons-grid",
    "volume",
    "backlight",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "mpris": {
      "image-size": 60,
      "image-radius": 12
    },
    "volume": {
      "label": "Sound"
    },
    "backlight": {
      "label": "Display"
    },
    "buttons-grid": {
      "buttons": [
        {
          "label": "󰤨  Wi-Fi",
          "command": "$HOME/.config/hypr/scripts/ui/rofi_network.sh"
        },
        {
          "label": "󰂯  Bluetooth",
          "command": "blueman-manager"
        },
        {
          "label": "🌙  Nightlight",
          "command": "$HOME/.config/hypr/scripts/ui/toggle_nightlight.sh"
        },
        {
          "label": "🎨  Dark Mode",
          "command": "$HOME/.config/hypr/scripts/ui/toggle_darkmode.sh"
        },
        {
          "label": "🖼️  Wallpaper",
          "command": "$HOME/.config/hypr/scripts/ui/switch_wallpaper.sh"
        },
        {
          "label": "🖥️  UI Engine",
          "command": "$HOME/.config/hypr/scripts/ui/toggle_ui_mode.sh"
        },
        {
          "label": "󰏔  Updates (12)",
          "command": "foot -e sudo pacman -Syu"
        },
        {
          "label": "󰍃  Power",
          "command": "$HOME/.config/hypr/scripts/ui/powermenu.sh"
        }
      ]
    }
  }
}
